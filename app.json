{
  "expo": {
    "name": "Sahajayoga Followup (Dev)",
    "slug": "sahajayogafollowup",
    "version": "2.0",
    "scheme": "sahajayoga-app",
    "splash": {
      "image": "./assets/images/splash_sy.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash_sy.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.sahajayoga.dev",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_sy.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Sahajayoga app needs access to your camera to scan seeker lists.",
          "enableMicrophonePermission": false
        }
      ]
    ],
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "Sahajayoga app needs access to your camera to scan seeker lists."
      },
      "bundleIdentifier": "com.sahajayoga.followup"
    },
    "extra": {
      "eas": {
        "projectId": "6ebf176f-2856-4d16-8cc8-8c09d1abfaa0"
      }
    }
  }
}
